---
import { Image } from 'astro:assets';
import kids from '@/assets/kids.jpg';
import type { Locale } from '@/content/types';
import { getContent, routes } from '@/i18n';
import Icon from './Icon.astro';
import Wave from './Wave.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const bookingHref = routes.booking[locale];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__blob hero__blob--1"></span>
    <span class="hero__blob hero__blob--2"></span>
    <span class="hero__blob hero__blob--3"></span>
  </div>

  <div class="container hero__inner">
    <div class="hero__text">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1 id="hero-title" set:html={t.hero.title} />
      <p class="hero__lead">{t.hero.text}</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href={bookingHref}><Icon name="calendar" />{t.hero.ctaPrimary}</a>
        <a class="btn btn--ghost" href={t.contact.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" class="wa" />{t.hero.ctaSecondary}</a>
      </div>
      <ul class="hero__chips" aria-label={locale === 'de' ? 'Auf einen Blick' : 'At a glance'}>
        {t.hero.chips.map((c) => (
          <li><Icon name="check" />{c}</li>
        ))}
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="false">
      <div class="hero__photo-wrap">
        <span class="hero__photo-bg"></span>
        <Image src={kids} alt={t.hero.photoAlt} widths={[480, 720, 960]} sizes="(max-width: 900px) 90vw, 520px" class="hero__photo" loading="eager" fetchpriority="high" />
      </div>

      <span class="hero__word hero__word--learn float" aria-hidden="true">learn</span>
      <span class="hero__word hero__word--fun float float--fast" aria-hidden="true">fun</span>
      <span class="hero__word hero__word--sing float float--slow" aria-hidden="true">sing</span>
      <span class="hero__word hero__word--colour float" aria-hidden="true">colour</span>
      <span class="hero__star float float--fast" aria-hidden="true"><Icon name="star" /></span>
      <svg class="hero__squiggle float" viewBox="0 0 120 40" aria-hidden="true"><path d="M4 22 C 20 2, 34 42, 50 22 S 80 2, 96 22 S 114 30, 116 20" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" /></svg>
    </div>
  </div>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <clipPath id="blob-clip" clipPathUnits="objectBoundingBox">
        <path d="M0.52 0.02 C0.74 0.02 0.95 0.17 0.97 0.4 C0.99 0.64 0.88 0.9 0.64 0.97 C0.42 1.03 0.13 0.92 0.04 0.68 C-0.04 0.44 0.09 0.13 0.31 0.05 C0.38 0.03 0.45 0.02 0.52 0.02 Z" />
      </clipPath>
    </defs>
  </svg>

  <Wave fill="var(--white)" />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(5rem, 9vw, 8rem);
    background: linear-gradient(180deg, #fff3f8 0%, var(--cream) 100%);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
  }
  .hero__blob--1 {
    width: 520px;
    height: 520px;
    background: #ffd6ea;
    top: -180px;
    right: -120px;
  }
  .hero__blob--2 {
    width: 380px;
    height: 380px;
    background: var(--yellow-soft);
    bottom: -120px;
    left: -100px;
  }
  .hero__blob--3 {
    width: 300px;
    height: 300px;
    background: var(--sky-soft);
    top: 40%;
    left: 45%;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
    z-index: 2;
  }
  .hero__inner > * {
    min-width: 0;
  }
  .hero__text h1 :global(em) {
    font-style: normal;
    color: var(--pink);
    position: relative;
    white-space: nowrap;
  }
  .hero__text h1 :global(em)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 0.28em;
    background: var(--yellow);
    border-radius: 999px;
    z-index: -1;
    opacity: 0.85;
  }
  .hero__lead {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--plum-soft);
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }
  .hero__actions :global(.wa) {
    color: var(--whatsapp);
  }
  .hero__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    font-weight: 700;
    color: var(--plum-soft);
    font-size: 0.98rem;
  }
  .hero__chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__chips li {
    white-space: nowrap;
  }
  .hero__chips :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--teal);
  }

  .hero__visual {
    position: relative;
    min-height: 460px;
  }
  .hero__photo-wrap {
    position: relative;
    width: min(100%, 520px);
    margin-left: auto;
    aspect-ratio: 1 / 0.92;
  }
  .hero__photo-bg {
    position: absolute;
    inset: -4% -3% -2% -5%;
    background: linear-gradient(135deg, var(--pink-light), var(--lilac));
    border-radius: 58% 42% 55% 45% / 48% 60% 40% 52%;
    transform: rotate(-6deg);
    opacity: 0.55;
  }
  .hero__photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: url(#blob-clip);
  }
  .hero__word {
    position: absolute;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    color: #fff;
    box-shadow: 0 10px 22px rgba(46, 26, 71, 0.16);
    white-space: nowrap;
  }
  .hero__word--learn {
    top: 4%;
    left: 4%;
    background: var(--teal);
    --rot: -8deg;
  }
  .hero__word--fun {
    top: -3%;
    right: 20%;
    background: var(--yellow);
    color: var(--plum);
    --rot: 7deg;
  }
  .hero__word--sing {
    top: 42%;
    right: -6%;
    background: var(--lilac);
    --rot: 6deg;
  }
  .hero__word--colour {
    bottom: 3%;
    left: 12%;
    background: var(--pink);
    --rot: -5deg;
  }
  .hero__star {
    position: absolute;
    top: 8%;
    right: -3%;
    color: var(--yellow);
    width: 44px;
    --rot: 15deg;
  }
  .hero__star :global(svg) {
    width: 100%;
    height: auto;
  }
  .hero__squiggle {
    position: absolute;
    left: 40%;
    bottom: -4%;
    width: 110px;
    color: var(--pink-light);
  }

  @media (max-width: 900px) {
    /* Single column. Flatten .hero__text so its children and the photo become
       siblings, then reorder for mobile: eyebrow, title, photo, intro, buttons, chips. */
    .hero__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1.4rem;
    }
    .hero__text {
      display: contents;
      text-align: center;
    }
    .hero__text > .eyebrow {
      order: 1;
      align-self: center;
      margin-bottom: 0;
    }
    .hero__text > h1 {
      order: 2;
      margin-bottom: 0;
    }
    .hero__visual {
      order: 3;
      min-height: 0;
      padding-bottom: 0;
    }
    .hero__text > .hero__lead {
      order: 4;
      margin: 0 auto;
    }
    .hero__text > .hero__actions {
      order: 5;
      margin-bottom: 0;
      justify-content: center;
    }
    .hero__text > .hero__chips {
      order: 6;
      justify-content: center;
    }
    .hero__photo-wrap {
      margin-inline: auto;
      width: min(100%, 440px);
    }
    .hero__word {
      font-size: 1.1rem;
      padding: 0.4rem 0.85rem;
    }
    .hero__word--learn {
      top: 0;
      left: 0;
    }
    .hero__word--fun {
      top: -2%;
      right: 6%;
    }
    .hero__word--sing {
      top: 46%;
      right: -1%;
    }
    .hero__word--colour {
      bottom: 4%;
      left: 2%;
    }
    .hero__star {
      right: 0;
      width: 36px;
    }
  }
  @media (max-width: 480px) {
    .hero__actions .btn {
      width: 100%;
    }
    .hero__squiggle {
      display: none;
    }
  }
</style>
