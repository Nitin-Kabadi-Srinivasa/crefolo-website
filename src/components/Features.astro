---
import type { Locale } from '@/content/types';
import { getContent, sectionIds } from '@/i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const colors = ['pink', 'yellow', 'teal', 'lilac', 'sky', 'green'];
---

<section class="section section--white features" id={sectionIds[locale].lessons}>
  <div class="container">
    <div class="section__head reveal">
      <span class="eyebrow">{locale === 'de' ? 'Der Unterricht' : 'The lessons'}</span>
      <h2>{t.features.title}</h2>
      <p>{t.features.intro}</p>
    </div>
    <ul class="grid grid--3 features__list">
      {t.features.items.map((f, i) => (
        <li class="card features__item reveal" data-delay={i % 3}>
          <div class={`icon-badge icon-badge--${colors[i % colors.length]}`}><Icon name={f.icon} /></div>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .features__item {
    transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.7s ease;
  }
  .features__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .features__item p {
    margin: 0;
    color: var(--muted);
  }
</style>
