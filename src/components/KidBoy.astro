---
// Cartoon boy mascot ("Ben"): spiky orange hair, sky-blue shirt with a star, cheering with both arms up.
interface Props {
  class?: string;
  size?: number;
  label?: string;
}
const { class: cls = '', size = 220, label = 'Fröhlicher Junge, der jubelt' } = Astro.props;
---

<svg class:list={['kid', 'kid--boy', cls]} width={size} viewBox="0 0 260 340" role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
  <g stroke="#2b1b3d" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
    <!-- arms up (cheering) -->
    <g class="kid__cheer kid__cheer--l">
      <path d="M 90 168 L 62 142 L 46 108" fill="none" stroke-width="23" />
      <path d="M 90 168 L 62 142 L 46 108" fill="none" stroke="#f3c7a0" stroke-width="15" />
      <circle cx="42" cy="102" r="12" fill="#f3c7a0" />
    </g>
    <g class="kid__cheer kid__cheer--r">
      <path d="M 150 168 L 178 142 L 194 108" fill="none" stroke-width="23" />
      <path d="M 150 168 L 178 142 L 194 108" fill="none" stroke="#f3c7a0" stroke-width="15" />
      <circle cx="198" cy="102" r="12" fill="#f3c7a0" />
    </g>

    <!-- legs -->
    <path d="M 104 252 L 96 300" fill="none" stroke-width="23" />
    <path d="M 104 252 L 96 300" fill="none" stroke="#f3c7a0" stroke-width="15" />
    <path d="M 136 252 L 146 300" fill="none" stroke-width="23" />
    <path d="M 136 252 L 146 300" fill="none" stroke="#f3c7a0" stroke-width="15" />
    <!-- socks -->
    <path d="M 98 286 L 96 300" fill="none" stroke="#fff" stroke-width="15" />
    <path d="M 143 286 L 146 300" fill="none" stroke="#fff" stroke-width="15" />
    <!-- shoes -->
    <ellipse cx="92" cy="313" rx="22" ry="11" fill="#ff7a1a" />
    <ellipse cx="150" cy="313" rx="22" ry="11" fill="#ff7a1a" />
    <path d="M 76 318 Q 92 325 108 318 M 134 318 Q 150 325 166 318" fill="none" stroke="#fff" stroke-width="3" />

    <!-- shorts -->
    <path d="M 90 214 L 150 214 L 156 254 L 126 254 L 120 240 L 114 254 L 84 254 Z" fill="#3b5bdb" />

    <!-- neck + shirt -->
    <rect x="110" y="128" width="20" height="28" rx="6" fill="#f3c7a0" />
    <path d="M 96 152 Q 120 144 144 152 L 150 218 Q 120 226 90 218 Z" fill="#5bb8f5" />
    <path d="M 98 152 Q 78 156 72 178 L 90 184 L 100 168 Z" fill="#5bb8f5" />
    <path d="M 142 152 Q 162 156 168 178 L 150 184 L 140 168 Z" fill="#5bb8f5" />
    <path d="M 108 152 Q 120 162 132 152" fill="none" stroke-width="3" />
    <path d="M 120 170 l 4.2 9 9.8 1.2 -7.2 6.8 1.9 9.8 -8.7 -4.8 -8.7 4.8 1.9 -9.8 -7.2 -6.8 9.8 -1.2 z" fill="#ffc53d" stroke-width="2.5" />

    <!-- ears, head, hair -->
    <circle cx="72" cy="104" r="9" fill="#f3c7a0" />
    <circle cx="168" cy="104" r="9" fill="#f3c7a0" />
    <circle cx="120" cy="96" r="46" fill="#f3c7a0" />
    <path d="M 74 96 C 74 62, 82 48, 94 46 L 90 22 L 108 42 L 114 14 L 126 42 L 142 16 L 146 44 L 166 28 L 160 52 C 170 60, 170 80, 168 96 C 152 80, 136 74, 120 80 C 104 74, 88 78, 74 96 Z" fill="#ff8a1f" />

    <!-- brows -->
    <path d="M 90 82 Q 102 76 114 82 M 126 82 Q 138 76 150 82" fill="none" />

    <!-- eyes -->
    <ellipse cx="102" cy="102" rx="13" ry="15" fill="#fff" stroke-width="3" />
    <ellipse cx="138" cy="102" rx="13" ry="15" fill="#fff" stroke-width="3" />

    <!-- nose + mouth -->
    <path d="M 121 108 q 4 6 -2 10" fill="none" stroke-width="3" />
    <path d="M 100 124 Q 120 154 140 124 Q 120 132 100 124 Z" fill="#c9264f" stroke-width="3.5" />
  </g>
  <path d="M 106 125 Q 120 131 134 125 Q 120 138 106 125 Z" fill="#fff" />
  <circle cx="105" cy="104" r="6" fill="#2b1b3d" />
  <circle cx="141" cy="104" r="6" fill="#2b1b3d" />
  <circle cx="107.5" cy="101" r="2.2" fill="#fff" />
  <circle cx="143.5" cy="101" r="2.2" fill="#fff" />
  <ellipse class="kid__lid" cx="102" cy="102" rx="14.5" ry="16.5" fill="#f3c7a0" />
  <ellipse class="kid__lid" cx="138" cy="102" rx="14.5" ry="16.5" fill="#f3c7a0" />
  <g fill="#d38a5a">
    <circle cx="90" cy="118" r="1.8" /><circle cx="97" cy="124" r="1.8" /><circle cx="104" cy="119" r="1.8" />
    <circle cx="136" cy="119" r="1.8" /><circle cx="143" cy="124" r="1.8" /><circle cx="150" cy="118" r="1.8" />
  </g>
  <circle cx="86" cy="118" r="7" fill="#ffb3a0" opacity="0.7" />
  <circle cx="154" cy="118" r="7" fill="#ffb3a0" opacity="0.7" />
</svg>

<style is:global>
  .kid--boy .kid__cheer--l {
    transform-origin: 90px 168px;
    animation: kid-cheer-l 2.2s ease-in-out infinite;
  }
  .kid--boy .kid__cheer--r {
    transform-origin: 150px 168px;
    animation: kid-cheer-r 2.2s ease-in-out infinite;
  }
  @keyframes kid-cheer-l {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(8deg);
    }
  }
  @keyframes kid-cheer-r {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .kid--boy .kid__cheer--l,
    .kid--boy .kid__cheer--r {
      animation: none;
    }
  }
</style>
