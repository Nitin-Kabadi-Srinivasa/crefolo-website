---
// "New group starts on …" banner below the hero. Dates come from src/content/schedule.ts;
// the banner hides itself in the browser once the group has started.
import type { Locale } from '@/content/types';
import { schedule } from '@/content/schedule';
import { getContent, routes } from '@/i18n';
import { berlinInstant, longDate, weekdaysPlural, numericDate, joinList, slotsText, upcomingTrials, todayYmd } from '@/lib/schedule-utils';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale).announcement;
const group = schedule.nextGroup;
const show = !!group && group.date >= todayYmd();

let title = '';
let text = '';
let trialsLine = '';
let slotsLine = '';
let until = '';
if (show && group) {
  until = berlinInstant(group.date, group.time).toISOString();
  title = t.title.replace('{date}', longDate(group.date, locale));
  text = t.text.replace('{weekdays}', weekdaysPlural(group.date, locale)).replace('{time}', group.time);
  const trials = upcomingTrials().filter((tr) => tr.date < group.date);
  if (trials.length) {
    const dates = [...new Set(trials.map((tr) => tr.date))].map(numericDate);
    trialsLine = t.trials.replace('{dates}', joinList(dates, locale));
    const slots = slotsText(trials, locale);
    if (slots) slotsLine = t.slots.replace('{slots}', slots);
  }
}
const bookingHref = routes.booking[locale];
---

{show && (
  <section class="announce" data-until={until} aria-labelledby="announce-title">
    <div class="container">
      <div class="announce__card reveal">
        <div class="announce__icon" aria-hidden="true"><Icon name="rocket" /></div>
        <div class="announce__body">
          <span class="announce__eyebrow"><span class="announce__dot" aria-hidden="true"></span>{t.eyebrow}</span>
          <h2 id="announce-title" class="announce__title">{title}</h2>
          <p class="announce__text">{text}</p>
          {trialsLine && <p class="announce__trials">{trialsLine}</p>}
          {slotsLine && <p class="announce__ages">{slotsLine}</p>}
        </div>
        <a class="btn btn--primary announce__cta" href={bookingHref}><Icon name="calendar" />{t.cta}</a>
      </div>
    </div>
  </section>
)}

<script>
  // Hide the announcement once the new group has started (the page itself is built ahead of time)
  document.querySelectorAll<HTMLElement>('.announce[data-until]').forEach((el) => {
    const until = Date.parse(el.dataset.until || '');
    if (Number.isFinite(until) && Date.now() >= until) el.hidden = true;
  });
</script>

<style>
  .announce {
    background: var(--white);
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 0;
  }
  .announce__card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.6rem 1.8rem;
    border-radius: var(--radius);
    background: linear-gradient(135deg, #fff4f9 0%, #fdf1ff 100%);
    border: 2px solid var(--pink-soft);
    box-shadow: var(--shadow);
  }
  .announce__icon {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: var(--pink);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-pink);
  }
  .announce__icon :global(svg) {
    width: 34px;
    height: 34px;
  }
  .announce__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--pink-deep);
    background: #fff;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }
  .announce__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 0 0 rgba(234, 24, 137, 0.5);
    animation: announce-pulse 2s infinite;
  }
  @keyframes announce-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(234, 24, 137, 0.45);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(234, 24, 137, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(234, 24, 137, 0);
    }
  }
  .announce__title {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    margin: 0 0 0.35rem;
  }
  .announce__body p {
    margin: 0;
    color: var(--plum-soft);
  }
  .announce__trials {
    margin-top: 0.35rem !important;
    font-weight: 700;
    color: var(--plum) !important;
  }
  .announce__ages {
    font-size: 0.95rem;
  }
  .announce__cta {
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .announce__card {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
      gap: 1rem;
      padding: 1.5rem 1.25rem;
    }
    .announce__cta {
      width: 100%;
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .announce__dot {
      animation: none;
    }
  }
</style>
