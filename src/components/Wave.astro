---
// Wavy section divider. Sits at the bottom of a section (or top with flip) and takes the colour of the next section.
interface Props {
  fill?: string;
  flip?: boolean;
  class?: string;
}
const { fill = 'var(--white)', flip = false, class: cls = '' } = Astro.props;
---

<div class:list={['wave', { 'wave--flip': flip }, cls]} aria-hidden="true">
  <svg viewBox="0 0 1440 70" preserveAspectRatio="none">
    <path d="M0 38 C 180 70, 360 8, 560 34 C 760 60, 900 6, 1100 30 C 1260 50, 1360 44, 1440 30 L1440 70 L0 70 Z" style={`fill:${fill}`}></path>
  </svg>
</div>

<style>
  .wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: clamp(34px, 5vw, 70px);
    line-height: 0;
    pointer-events: none;
    z-index: 1;
  }
  .wave--flip {
    top: -1px;
    bottom: auto;
    transform: rotate(180deg);
  }
  .wave svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
