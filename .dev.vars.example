# Copy to .dev.vars for local development (never commit .dev.vars)

# 1 = fake calendar + no emails (design work without any accounts)
MOCK=1
# Links in emails/pages point here during local development
SITE_URL=http://localhost:8787

# Google Calendar (OAuth client from Google Cloud Console + one-time refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Microsoft 365 app registration (sends mail as info@crefolo.com)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Cloudflare Turnstile secret (test secret below always passes)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Random long string used to sign cancel links
CANCEL_SECRET=change-me-to-a-long-random-string
